__pycache__/
*.egg-info/
.venv/
be.out/
be.npz
NC*.out
models/*/runs/

build/

# Retired by the study author: anything prefixed __ is superseded input,
# an archived run, or a disabled script. Kept on disk, not in history.
# ** so it holds at any depth -- a retired mesh lives in <study>/geometry/,
# and a whole archived study sits directly under models/.
models/**/__*
# Generated by look.py / compare.py / reciprocity.py / reciprocity_report.py /
# energy.py / sh_check.py / timing.py / hutubs_compare.py / results_report.py —
# reproducible from the meshes and the solved runs. The narrative reports that
# cite them (RECIPROCITY.md, VALIDATION.md, RESULTS.md) are hand-written and
# ARE tracked; only the regenerable bundles are not.
models/*/look_*.png
models/*/look_*.vtp
models/*/compare*.png
models/*/reciprocity_*.png
models/*/reciprocity_report/
models/*/validation_report/
models/*/results_report/
models/*/field_*.png
models/*/field_*.vtp
models/*/probevel_*.png
# intensity2d_*/intensity3d_* are intensity_quiver.py and
# intensity_glyphs.py's names; the bare glob covers all three.
models/*/intensity*.png
# casestudy_earbuds_mics generates its own bundle the same way: build_report.py
# writes report/ (figures, tables, the PDF) and make_audio.py writes audio/.
# report.md — the prose the PDF is assembled from — is hand-written and IS
# tracked, as are the four scripts.
models/*/casestudy_*/report/
models/*/casestudy_*/audio/
# pinna_view.py's own output: the resonance scan and its rendered panels.
models/*/pinna_*.png
# build.py's own transcript, and fit_report.py's measurement cache. The cache is
# keyed on each mesh's size and mtime, which a checkout does not preserve, so a
# committed one could never be used -- it would miss on the first read and be
# re-measured. Both are regenerable from the meshes.
models/*/build*.log
models/*/fit_report.txt
models/*/mesh/fit_report_cache.json
